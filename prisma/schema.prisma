generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  BARBERSHOP_OWNER
  BARBER
  ASSISTANT
}

model User {
  id          String           @id @default(uuid())
  name        String
  email       String           @unique
  password    String
  role        Role             @default(BARBER)
  photoUrl    String?
  createdAt   DateTime         @default(now())
  memberships BarbershopUser[]
}

model Professional {
  id              String    @id @default(uuid())
  name            String
  email           String?   @unique
  role            String
  permissionLevel String?
  commission      Int
  specialties     String[]
  photoUrl        String?
  status          String    @default("PENDING")
  password        String?
  inviteToken     String?
  inviteExpires   DateTime?
  createdAt       DateTime  @default(now())
}

model Barbershop {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  members BarbershopUser[]
  tvMedia TvMedia[]
}

model BarbershopUser {
  id           String   @id @default(uuid())
  userId       String
  barbershopId String
  role         Role
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  barbershop Barbershop @relation(fields: [barbershopId], references: [id])

  @@unique([userId, barbershopId])
}

model TvMedia {
  id           String   @id @default(cuid())
  barbershopId String
  name         String
  url          String
  type         String   @default("VIDEO")
  order        Int      @default(0)
  active       Boolean  @default(true)
  duration     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
}
