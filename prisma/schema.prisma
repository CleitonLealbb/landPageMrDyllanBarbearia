generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(BARBER)
  createdAt DateTime @default(now())
}

enum Role {
  OWNER
  BARBER
}

model Professional {
  id              String   @id @default(uuid())
  name            String
  email           String?  @unique
  role            String
  permissionLevel String?
  commission      Int
  specialties     String[]
  photoUrl        String?
  status          String   @default("PENDING")
  password        String?
  inviteToken     String?
  inviteExpires   DateTime?
  createdAt       DateTime @default(now())
}